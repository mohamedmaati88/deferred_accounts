<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_post_due_deferred_lines" model="ir.cron">
        <field name="name">Deferred Recognition: Post Due Lines</field>
        <field name="model_id" ref="model_account_deferred_line"/>
        <field name="state">code</field>
        <field name="code">model.search([('state', '=', 'draft'), ('is_initial', '=', False)]).action_post_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
